# Copie os valores necessários para o ambiente do processo antes de iniciar o backend.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_me

# Substitua usuário e senha pelos dados da sua instância local MySQL.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/financeiro_familiar

# Credenciais de contas de teste criadas especificamente na sua base de desenvolvimento.
TEST_BASE_URL=http://127.0.0.1:8000
TEST_MEMBER_EMAIL=member@example.com
TEST_MEMBER_PASSWORD=replace_with_member_test_password
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=replace_with_admin_test_password
