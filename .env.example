# Gere uma chave única e privada com:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Não use o texto abaixo como chave real.
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters

# SQLite local; caminhos relativos são resolvidos a partir da raiz do projeto.
DATABASE_URL=sqlite:///./financeiro_familiar.db

# Origens do frontend separadas por vírgulas.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Variáveis opcionais para testar uma API já iniciada com contas descartáveis.
TEST_BASE_URL=http://127.0.0.1:8000
TEST_MEMBER_EMAIL=member-test@example.com
TEST_MEMBER_PASSWORD=replace_with_member_test_password
TEST_ADMIN_EMAIL=admin-test@example.com
TEST_ADMIN_PASSWORD=replace_with_admin_test_password
